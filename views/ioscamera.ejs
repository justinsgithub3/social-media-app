<!DOCTYPE html>
<html>

<head>
  <title>Camera</title>
  <link rel="icon" type="image/png" href="assets/blue-circle.png"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
    integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/style1.css"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Capriola&display=swap');

    .loading::after {
        content: " ...";
        animation: dots 1s infinite;
        display: inline-block;
        width: 20px;
        text-align: left;
    }
    @keyframes dots {
        0%, 20% { content: "."; }
        40% { content: ".."; }
        60%, 100% { content: "..."; }
    }
  </style>
</head>

<body>
    <div class="header">
        <h1 class="capriola-regular mb-3 mt-2">Camera</h1>
        <a class="capriola-regular main-link" href="/">Main</a>
        <a class="capriola-regular album-link" href="/album">Album</a>
    </div>
    
    
    <form class="post-form" method="POST" enctype="multipart/form-data" action="/upload">
      <label for="form-image" class="capriola-regular camera-label">
          <span id="button-text">Camera</span>
          <input class="camera" id="form-image" type="file" name="form-image" 
                 accept="image/*" capture="user" style="display: none;"/>
      </label>
  </form>


  <script>
    document.getElementById('form-image').addEventListener('change', function() {
        const buttonText = document.getElementById('button-text');
        const originalText = buttonText.textContent;
        
        // Show loading state
        buttonText.textContent = "Uploading";
        buttonText.classList.add('loading');
        
        // Store original text in data attribute for later use
        buttonText.dataset.originalText = originalText;
        
        // Submit form
        this.form.submit();
        
        // Reset after 3 seconds
        setTimeout(() => {
            buttonText.textContent = buttonText.dataset.originalText;
            buttonText.classList.remove('loading');
            fileInput.value = '';
        }, 5000);
    });

  </script>
</body>

</html>